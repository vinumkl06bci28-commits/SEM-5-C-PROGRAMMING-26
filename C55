int* decrypt(int* code, int codeSize, int k, int* returnSize) {
    int *encrypt = (int*) calloc(4, codeSize);

    if(k>=0){
        for(int i = 0, sum; i < codeSize; i++){
            sum = 0;
            for(int j = i + 1; j <= i + k; j++){
                sum += code[j % codeSize];
            }
            encrypt[i] = sum;
        }
    }
    else{
         for(int i = 0, sum; i < codeSize; i++){
            sum = 0;
            for(int j = i - 1; j >= i + k; j--){
                sum += code[(codeSize + j) % codeSize];
            }
            encrypt[i] = sum;
        }
    }

    *returnSize=codeSize;
    return encrypt;
}
