int* sortArrayByParity(int* nums, int numsSize, int* returnSize) {
    int j = 0;
    int* arr = (int*)malloc(numsSize * sizeof(int));
    for (int i = 0; i < numsSize; i++) {
        if (nums[i] % 2 == 0) {
            arr[j] = nums[i];
            j++;
        }
    }
    for (int i = 0; i < numsSize; i++) {
        if (nums[i] % 2 != 0) {
            arr[j] = nums[i];
            j++;
        }
    }
    *returnSize = numsSize;
    return arr;
}
