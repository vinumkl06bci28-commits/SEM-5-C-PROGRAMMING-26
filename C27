int* findDisappearedNumbers(int* nums, int numsSize, int* returnSize)
{
    int i;
    int k;
    int tab[100001] = {0};
    int *total;

    i = 0;
    k = 0;
    while (i < numsSize)
    {
        tab[nums[i]]++;
        i++;
    }
    i = 1;
    while (i < numsSize + 1)
    {
        if (!tab[i])
            k++;
        i++;
    }
    *returnSize = k;
    total = malloc(k * sizeof(int));
    i = 1;
    k = 0;
    while (i < numsSize + 1)
    {
        if (!tab[i])
        {
            total[k] = i;
            k++;
        }
        i++;
    }
    return (total);
}
