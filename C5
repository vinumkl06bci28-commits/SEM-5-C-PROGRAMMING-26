bool containsDuplicate(int* nums, int n) {
    int min = nums[0];
    int max = nums[0];
    for(int i = 1; i < n; i++)
    {
        if(nums[i] < min) min = nums[i];
        if(nums[i] > max) max = nums[i];
    }
    int size = max-min+1;
    bool* hash_table = calloc(size, sizeof(bool));
    int x;
    for(int i = 0; i < n; i++)
    {
        x = nums[i] - min;
        if(hash_table[x]) return true;
        hash_table[x] = true;
    }
    return false;
}
