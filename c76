typedef struct Node{
    int val;
    struct Node*next;
} node;

typedef struct{
    node*top;
    int size;
} Stack;

Stack* createS(){
    Stack* ss=malloc(sizeof(Stack));
    ss->top=NULL;
    ss->size=0;
    return ss;
}

void push(Stack* ss,int x){
    node* newNode=malloc(sizeof(node));
    newNode->val=x;
    newNode->next=NULL;
    if(ss->top)newNode->next=ss->top;
    ss->top=newNode;
    ss->size++;
}

int pop(Stack*ss){
    if(!ss->top)return -1;
    node*temp=ss->top;
    int val=temp->val;
    ss->top=temp->next;
    ss->size--;
    free(temp);
    return val;
}

int peek(Stack*ss){
    return ss->top?ss->top->val:-1;
}

bool isEmptyStack(Stack*ss){
    return ss->size==0;
}

typedef struct {
    Stack*inStack;
    Stack*outStack;
} MyQueue;


MyQueue* myQueueCreate() {
    MyQueue*obj=malloc(sizeof(MyQueue));
    obj->inStack=createS();
    obj->outStack=createS();
    return obj;
}

void myQueuePush(MyQueue* obj, int x) {
    push(obj->inStack,x);
}

int myQueuePop(MyQueue* obj) {
    if(isEmptyStack(obj->outStack)){
        while (!isEmptyStack(obj->inStack)){
            push(obj->outStack,pop(obj->inStack));
        }
    }
    return pop(obj->outStack);
}

int myQueuePeek(MyQueue* obj) {
    if(isEmptyStack(obj->outStack)){
        while (!isEmptyStack(obj->inStack)){
            push(obj->outStack,pop(obj->inStack));
        }
    }
    return peek(obj->outStack);
}

bool myQueueEmpty(MyQueue* obj) {
    return (isEmptyStack(obj->inStack) && isEmptyStack(obj->outStack));
}

void myQueueFree(MyQueue* obj) {
    free(obj->inStack);
    free(obj->outStack);
    free(obj);
}
