void rev_word(char *tmp, char *str, int index, int lenght)
{
    int i;

    i = 0;
    if (lenght)
        lenght--;
    index += lenght;
    while (index >= 0 && str[index] != ' ')
    {
        tmp[i] = str[index];
        index--;
        i++;
    }
}

int word_len(char *str, int index)
{
    int count;

    count = 0;
    while (str[index] != '\0' && str[index] != ' ')
    {
        count++;
        index++;
    }
    return (count);
}

int string_len(char *str)
{
    int count;
    int i;

    count = 0;
    i = 0;
    while (str[i])
    {
        count++;
        i++;
    }
    return (count);
}

char* reverseWords(char* s)
{
    char    *total;
    int     i;
    int     k;
    int     x;
    int     len;
    char    *tmp;

    if (!s)
        return (NULL);
    total = malloc(string_len(s) + 1);
    i = 0;
    k = 0;
    x = 0;
    tmp = NULL;
    if (!total)
        return (NULL);
    while (s[i])
    {
        while(s[i] == ' ')
            i++;
        len = word_len(s, i);
        if (!len)
            break ;
        tmp = malloc(len);
        if (!tmp)
            return (NULL);
        rev_word(tmp, s, i,len);
        while(k < len)
        {
            total[x] = tmp[k];
            x++;
            i++;
            k++;
        }
        k = 0;
        if (s[i] != '\0')
        {
            total[x] = ' ';
            x++;
        }
    }
    total[x] = '\0';
    free(tmp);
    return (total);
}
