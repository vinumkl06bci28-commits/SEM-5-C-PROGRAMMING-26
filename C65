int numberOfAlternatingGroups(int* c, int size) {
    int cnt = size;
    int time = 1;
    int col = 0;
    
    if (c[cnt - 1] != c[cnt - 2] && c[cnt - 1] != c[0]) { 
        col++;
    } 
    if (c[1] != c[0] && c[cnt - 1] != c[0]) { 
        col++;
    }
    
    for (int i = 2; i < size; i++) {
        if (c[time] != c[time - 1] && c[time] != c[time + 1]) {
            col++;
        }
        time++;
    }
    return col;
}
