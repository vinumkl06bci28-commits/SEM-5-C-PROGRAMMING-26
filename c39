int check(char* s,int l,int r){
    if(l==r){
        return 1;
    }
    while(l<r){
        if(s[l]!=s[r]){
            return 0;
        }
        l++;
        r--;
    }
    return 1;
}

bool validPalindrome(char* s) {
    int n = strlen(s);
    for(int i=0;i<n/2;i++){
        if(s[i]!=s[n-i-1]){
            if(check(s,i,n-i-2) || check(s,i+1,n-i-1)){
                return true;
            }
            else{
                return false;
            }
        }
    }
    return true;
}
