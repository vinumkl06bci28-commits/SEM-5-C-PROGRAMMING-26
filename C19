int diff(const char* w1, const char* w2){
    int d = 0; 
    for(int i = 0; w1[i]; i++){
        if(w1[i] != w2[i]){
            d++;
            if(d > 1){
                return 0;
            }
        }
    }
    return 1;
}

int ladderLength(char* beginWord, char* endWord, char** wordList, int wordListSize) {
    int found = 0;
    for(int i = 0; i < wordListSize; i++){
        if(strcmp(endWord, wordList[i]) == 0){
            found = 1;
            break;
        }
    }
    if(!found){
        return 0;
    }
    int visited[wordListSize];
    memset(visited, 0, sizeof(visited));
    char queue[wordListSize + 1][10];
    int front = 0;
    int rear = 0;
    int level = 1;

    strcpy(queue[rear++], beginWord);
    while(front < rear){
        int levelSize = rear - front;
        for(int i = 0;  i < levelSize; i++){
            char *cur = queue[front++];
            for(int j = 0; j < wordListSize; j++){
                if(!visited[j] && diff(cur, wordList[j])){
                    if(strcmp(endWord, wordList[j]) == 0){
                        return level + 1;
                    }
                    visited[j] = 1;
                    strcpy(queue[rear++], wordList[j]);
                }
            }
        }
        level++;
    }
    return 0;
}
