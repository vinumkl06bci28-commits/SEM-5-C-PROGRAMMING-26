#define max(a,b) ( a > b ? a:b)

int longestAlternatingSubarray(int* nums, int numsSize, int threshold) {
    int length=0;
    int maxl = 0;
    int temp;
    for(int i=0; i < numsSize;i++){
        if(nums[i] <= threshold && nums[i]%2==0){
            for(temp = i+1 ; temp < numsSize && (nums[temp]%2 != nums[temp-1]%2) ;temp++){
                if(nums[temp]> threshold) break;
            }
            maxl = max(maxl,temp-i);
            i=temp-1;
        }
    }
    return maxl;
}
