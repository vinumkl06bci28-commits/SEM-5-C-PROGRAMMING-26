int lengthOfLongestSubstring(char* s) 
{
    bool arr[260]={0};
    int l=0,max=0,count=0;
    for(int r=0;s[r]!='\0';r++)
    {
        while(arr[s[r]]==1){
          arr[s[l]]=0;
          l++; 
        }
        arr[s[r]]=1;
        count=r-l+1;
        if(count>max)
         max=count;
        }
         return max;
    }
  
   
